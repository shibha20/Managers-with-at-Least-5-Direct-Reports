WITH ManagerReportCount AS (
    SELECT
        managerId,
        COUNT(*) AS totalDirectReports
    FROM Employee
    WHERE managerId IN (
        SELECT id
        FROM Employee
    )
    GROUP BY managerId
)

SELECT
    e.name
FROM Employee AS e
INNER JOIN ManagerReportCount AS m
    ON e.id = m.managerId
WHERE m.totalDirectReports >= 5;
